# ============================================================
# YOUR BOILER LTD — ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local to source control.
# ============================================================

# ─── SUPABASE API CONFIGURATION ─────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key

# Server-only service role key with admin privileges (bypasses RLS)
# DO NOT prefix with NEXT_PUBLIC_ — this must never be exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-private-key

# Postgres direct database connection URL (used for migrations and seed scripts)
SUPABASE_DB_URL=postgres://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-HOST]:5432/postgres

# ─── RESEND TRANSACTIONAL EMAIL CONFIGURATION ───────────────
# Found in: Resend Dashboard (https://resend.com) -> API Keys
RESEND_API_KEY=re_cxKgfprB_3tSbybJURaVHkM1ZKr2kwsW5

# The sender address. In testing, use: onboarding@resend.dev
# In production, use your verified domain address: e.g. compliance@yourboiler.co.uk
RESEND_FROM_EMAIL=Your Boiler Ltd <onboarding@resend.dev>

# Secret token securing the automated reminders cron endpoint: /api/cron/reminders
CRON_SECRET=generate-a-strong-random-secret-key-here

# ─── WEB PUSH (VAPID) NOTIFICATION KEYS ─────────────────────
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-for-pwa-push-subscriptions
VAPID_PRIVATE_KEY=your-vapid-private-key-for-sending-push
VAPID_SUBJECT=mailto:admin@yourboiler.co.uk

# ─── APPLICATION ENVIRONMENT ────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
